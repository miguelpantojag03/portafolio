<p class="aviso" role="status" aria-live="polite" data-aviso></p>

<style>
  .aviso {
    position: fixed;
    left: 50%;
    bottom: var(--e-5);
    z-index: var(--z-aviso);
    max-width: calc(100vw - 2 * var(--e-4));
    padding: var(--e-3) var(--e-5);
    border-radius: var(--radio-boton);
    background: var(--tinta);
    color: var(--fondo);
    font-weight: 650;
    transform: translate(-50%, calc(100% + var(--e-6)));
    opacity: 0;
    transition:
      transform var(--dur-media) var(--curva),
      opacity var(--dur-media) var(--curva);
    pointer-events: none;
  }

  .aviso:empty {
    visibility: hidden;
  }

  .aviso[data-visible] {
    transform: translate(-50%, 0);
    opacity: 1;
  }

  /* El color de estado entra como borde: el texto mantiene el contraste máximo. */
  .aviso[data-tipo='exito'] {
    box-shadow: inset 0 0 0 3px var(--exito);
  }

  .aviso[data-tipo='error'] {
    box-shadow: inset 0 0 0 3px var(--error);
  }
</style>
