---
import { formaDeTrabajo, tecnologias, type Tecnologia } from '@/data/perfil';
import { titulosPorSlug } from '@/lib/proyectos';

const titulos = await titulosPorSlug();

const grupos: { id: string; titulo: string; nota: string; items: Tecnologia[] }[] = [
  {
    id: 'en-proyectos',
    titulo: 'Usadas en estos proyectos',
    nota: 'Cada una lleva al proyecto donde la puedes ver.',
    items: tecnologias.enProyectos,
  },
  {
    id: 'fuera',
    titulo: 'También las he usado',
    nota: 'En clases y prácticas que no están publicadas aquí.',
    items: tecnologias.fueraDeProyectos,
  },
  {
    id: 'aprendiendo',
    titulo: 'Estoy aprendiendo',
    nota: '',
    items: tecnologias.aprendiendo,
  },
].filter((g) => g.items.length > 0);
---

<section class="seccion" id="como-trabajo" aria-labelledby="trabajo-titulo">
  <div class="contenedor trabajo">
    <h2 id="trabajo-titulo" class="titulo-seccion">
      Cómo trabajo
    </h2>

    <ul class="habitos" role="list">
      {formaDeTrabajo.map((h, i) => (
        <li class="habito vidrio revelar">
          <span class="habito__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="habito__titulo">{h.titulo}</h3>
          <p class="texto-suave">{h.texto}</p>
        </li>
      ))}
    </ul>

    <div class="tecnologias">
      {grupos.map((g) => (
        <section class="grupo revelar" aria-labelledby={`grupo-${g.id}`}>
          <h3 id={`grupo-${g.id}`} class="grupo__titulo">
            {g.titulo}
          </h3>
          {g.nota && <p class="grupo__nota texto-suave">{g.nota}</p>}
          <ul class="tabla" role="list">
            {g.items.map((t) => (
              <li class="fila">
                <span class="fila__nombre">{t.nombre}</span>
                {t.proyectos && t.proyectos.length > 0 ? (
                  <span class="fila__donde">
                    {t.proyectos.map((slug, i) => (
                      <>
                        <a href={`/proyectos/${slug}`}>{titulos.get(slug) ?? slug}</a>
                        {i < t.proyectos!.length - 1 && ', '}
                      </>
                    ))}
                  </span>
                ) : (
                  t.nota && <span class="fila__donde texto-suave">{t.nota}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .habitos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-4);
    list-style: none;
    padding: 0;
    margin-bottom: var(--e-9);
  }

  .habito {
    position: relative;
    overflow: hidden;
    padding: var(--e-6) var(--e-5) var(--e-5);
    border-radius: var(--radio-tarjeta);
    transition:
      border-color var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  .habito:hover {
    border-color: color-mix(in srgb, var(--accion) 55%, transparent);
    box-shadow: var(--brillo);
  }

  /* Número grande y con degradado, como el dorsal de un hábito. */
  .habito__num {
    display: block;
    margin-bottom: var(--e-3);
    font-size: 2.5rem;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    background: var(--degradado);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .habito__titulo {
    font-size: var(--t-2);
    font-stretch: 110%;
    font-weight: 750;
    margin-bottom: var(--e-3);
  }

  .habitos p {
    max-width: 40ch;
  }

  .tecnologias {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--e-8);
    align-items: start;
  }

  .grupo__titulo {
    font-size: var(--t-2);
    font-stretch: 110%;
    font-weight: 750;
  }

  .grupo__nota {
    margin-top: var(--e-2);
    font-size: 0.9375rem;
  }

  /* Mosaico: cada tecnología es una ficha con el proyecto donde se ve. */
  .tabla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: var(--e-3);
    list-style: none;
    padding: 0;
    margin-top: var(--e-5);
  }

  .fila {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--e-1);
    padding: var(--e-4);
    border: 1px solid var(--borde);
    border-radius: 14px;
    background: var(--vidrio);
    transition:
      border-color var(--dur-media) var(--curva),
      translate var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  .fila:hover {
    border-color: color-mix(in srgb, var(--accion) 55%, transparent);
    box-shadow: var(--brillo);
    translate: 0 -3px;
  }

  /* Un punto de color: verde si se ve en un proyecto publicado. */
  .fila__nombre {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    font-weight: 700;
  }

  .fila__nombre::before {
    content: '';
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--tinta-suave);
  }

  #grupo-en-proyectos ~ .tabla .fila__nombre::before {
    background: var(--resalte);
    box-shadow: 0 0 10px var(--resalte);
  }

  .fila__donde {
    padding-left: calc(0.5rem + var(--e-2));
    font-size: 0.875rem;
  }

  .fila__donde a {
    min-height: 1.5rem;
    text-decoration-thickness: 1px;
  }

  .fila__donde a:hover {
    color: var(--accion);
  }

  @media (max-width: 55rem) {
    .tecnologias {
      grid-template-columns: 1fr;
    }
  }
</style>
