---
/**
 * Trabajo en equipo: una foto trabajando con compañeros y lo que ellos dicen.
 * Los testimonios viven en src/data/perfil.ts, con el texto tal como lo escribió cada persona.
 */
import { Image } from 'astro:assets';
import foto from '@/assets/fotos/equipo.png';
import { testimonios } from '@/data/perfil';

const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0])
    .join('');
---

<section class="seccion" id="equipo" aria-labelledby="equipo-titulo">
  <div class="contenedor">
    <h2 id="equipo-titulo" class="titulo-seccion">
      Trabajo en equipo
    </h2>
    <p class="entradilla texto-suave equipo__intro">
      Lo que dicen de mí compañeros con los que he trabajado en proyectos de la universidad.
    </p>

    <div class="equipo">
      <figure class="equipo__foto revelar">
        <Image
          src={foto}
          alt="Tres estudiantes trabajan con sus portátiles alrededor de una mesa en una biblioteca."
          widths={[360, 540, 720]}
          sizes="(min-width: 64rem) 26rem, (min-width: 40rem) 60vw, 92vw"
          loading="lazy"
        />
        <figcaption>Sesión de trabajo con compañeros de la universidad.</figcaption>
      </figure>

      <ul class="testimonios" role="list">
        {testimonios.map((t, i) => (
          <li class="testimonio revelar" style={`--i:${i}`}>
            <figure>
              <span class="testimonio__comillas" aria-hidden="true">
                “
              </span>
              <blockquote>
                <p>{t.texto}</p>
              </blockquote>
              <figcaption class="testimonio__autor">
                <span class="testimonio__avatar" aria-hidden="true">
                  {iniciales(t.nombre)}
                </span>
                <span>
                  <span class="testimonio__nombre">{t.nombre}</span>
                  <span class="testimonio__relacion">{t.relacion}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .equipo__intro {
    margin-top: calc(-1 * var(--e-5));
    margin-bottom: var(--e-7);
    max-width: 48ch;
  }

  .equipo {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: var(--e-7);
    align-items: start;
  }

  /* La foto se queda quieta mientras se leen los testimonios, con el marco degradado de la marca. */
  .equipo__foto {
    position: sticky;
    top: 6.5rem;
  }

  .equipo__foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 3px solid transparent;
    border-radius: var(--radio-tarjeta);
    background:
      linear-gradient(var(--fondo), var(--fondo)) padding-box,
      var(--degradado) border-box;
    box-shadow: 0 40px 80px -30px color-mix(in srgb, var(--accion) 60%, transparent);
  }

  .equipo__foto figcaption {
    margin-top: var(--e-3);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }

  .testimonios {
    display: grid;
    gap: var(--e-5);
    list-style: none;
    padding: 0;
  }

  .testimonio figure {
    position: relative;
    overflow: hidden;
    padding: var(--e-5) var(--e-6);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
    background:
      radial-gradient(90% 120% at 0% 0%, color-mix(in srgb, var(--accion) 10%, transparent), transparent 60%),
      var(--vidrio);
    backdrop-filter: blur(12px);
    box-shadow: var(--sombra);
    transition:
      border-color var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva),
      translate var(--dur-media) var(--curva);
  }

  .testimonio figure:hover {
    border-color: color-mix(in srgb, var(--accion) 55%, transparent);
    box-shadow: var(--brillo);
    translate: 0 -3px;
  }

  /* Comillas grandes con el degradado, encima de la cita. */
  .testimonio__comillas {
    display: block;
    height: 2.25rem;
    margin-bottom: var(--e-2);
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    background: var(--degradado);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .testimonio blockquote {
    margin: 0;
  }

  .testimonio blockquote p {
    position: relative;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .testimonio__autor {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    margin-top: var(--e-5);
    padding-top: var(--e-4);
    border-top: 1px solid var(--borde);
  }

  .testimonio__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--degradado);
    color: var(--sobre-accion);
    font-weight: 850;
    font-stretch: 115%;
  }

  .testimonio__nombre {
    display: block;
    font-weight: 750;
    font-stretch: 108%;
  }

  .testimonio__relacion {
    display: block;
    color: var(--tinta-suave);
    font-size: 0.875rem;
  }

  @media (max-width: 64rem) {
    .equipo {
      grid-template-columns: 1fr;
    }

    .equipo__foto {
      position: static;
      max-width: 28rem;
    }
  }

  @media (max-width: 40rem) {
    .testimonio figure {
      padding: var(--e-5) var(--e-4) var(--e-4);
    }
  }
</style>
