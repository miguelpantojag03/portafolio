---
import Cancha from '@/components/Cancha.astro';
import { perfil } from '@/data/perfil';
import { obtenerProyectos } from '@/lib/proyectos';
import { enlaceSolicitud, mensajeSolicitud } from '@/lib/solicitud';

const solicitud = enlaceSolicitud();

const palabras = ['Miguel', 'Ángel', 'Pantoja', 'Guerra'];

/** Lo que va escribiendo la línea de terminal del hero: un ejemplo real por proyecto. */
const construyo = [
  'apps para relojes Wear OS',
  'APIs REST con Spring Boot',
  'apps móviles con IA',
  'videojuegos en Unity',
  'interfaces que se usan con teclado',
];

/** Marcador: solo datos comprobables, sacados del perfil y de los proyectos publicados. */
const marcador = [
  { valor: String((await obtenerProyectos()).length), texto: 'proyectos publicados' },
  { valor: '4', texto: 'plataformas: reloj, móvil, web y juego' },
  { valor: perfil.grado.match(/\d{4}/)?.[0] ?? '', texto: 'año de grado' },
];
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="contenedor hero__rejilla">
    <div class="hero__texto">
      <p class="hero__rol">
        {perfil.rol} · {perfil.ciudad}
      </p>
      <!-- El ancho de la tipografía responde al puntero (eje wdth de Archivo). Ver script. -->
      <h1 id="hero-titulo" class="hero__nombre" data-nombre-elastico>
        {palabras.map((p, i) => (
          <span class="hero__palabra" style={`--i:${i}`}>
            {p}
          </span>
        ))}
      </h1>
      <p class="hero__que-hago">{perfil.queHago}</p>
      <!-- Línea de terminal que se escribe sola: decorativa, el mismo contenido está en los proyectos. -->
      <p class="hero__escribe" aria-hidden="true" data-escribe={JSON.stringify(construyo)}>
        <span class="hero__prompt">$ construyendo</span>
        <span class="hero__texto-escrito" data-escrito>
          {construyo[0]}
        </span>
        <span class="hero__cursor"></span>
      </p>
      <p class="hero__disponible">{perfil.disponibilidad}</p>
      <div class="hero__acciones">
        <a
          class="boton boton--principal"
          href={solicitud.href}
          data-solicitar={mensajeSolicitud()}
          {...(solicitud.externo ? { target: '_blank', rel: 'noopener' } : {})}
        >
          Solicitar un proyecto
        </a>
        <a class="boton" href="#proyectos">
          Ver mis proyectos
        </a>
      </div>
      <p class="hero__secundario">
        <a href="#servicios">Lo que hago</a>
        <span aria-hidden="true">·</span>
        <a href="/cv">Ver mi CV</a>
      </p>
      <dl class="marcador">
        {marcador.map((m, i) => (
          <div class="marcador__dato" style={`--i:${i}`}>
            <dt>{m.texto}</dt>
            <dd data-cuenta={m.valor}>{m.valor}</dd>
          </div>
        ))}
      </dl>
    </div>

    <Cancha />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: var(--e-7) var(--e-8);
  }

  /* Halo de color detrás de todo: azul y verde, como luces de estadio. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 60rem;
    max-height: 60rem;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--azul) 28%, transparent), transparent 70%),
      radial-gradient(
        closest-side at 30% 70%,
        color-mix(in srgb, var(--verde-vivo) 22%, transparent),
        transparent 70%
      );
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }

  .hero__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--e-8);
    align-items: center;
  }

  .hero__texto {
    container-type: inline-size;
  }

  .hero__rol {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: var(--e-1) var(--e-4);
    border-radius: var(--radio-boton);
    border: 1px solid var(--borde-fuerte);
    background: var(--vidrio);
    backdrop-filter: blur(10px);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .hero__rol::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--resalte);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--resalte) 25%, transparent);
    animation: latido 2.4s ease-out infinite;
  }

  .hero__nombre {
    --ancho: 112;
    margin-top: var(--e-5);
    /* Medido para que «PANTOJA» quepa en la columna aun con el ancho máximo (125 %). */
    font-size: min(15cqi, 7.4rem);
    font-weight: 900;
    font-stretch: calc(var(--ancho) * 1%);
    line-height: 0.96;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--tinta);
    text-wrap: initial;
  }

  .hero__palabra {
    display: block;
    animation: entrar var(--dur-larga) var(--curva) backwards;
    animation-delay: calc(var(--i) * 90ms + 100ms);
  }

  /* Los apellidos con el degradado azul → verde: el nombre en la espalda de la camiseta. */
  .hero__palabra:nth-child(n + 3) {
    background: var(--degradado);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 6px 30px color-mix(in srgb, var(--accion) 35%, transparent));
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      font-stretch: 62%;
    }
  }

  .hero__que-hago {
    margin-top: var(--e-6);
    font-size: var(--t-3);
    font-stretch: 110%;
    font-weight: 750;
    line-height: 1.15;
    max-width: 24ch;
  }

  @keyframes latido {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--resalte) 60%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  /* Línea de terminal: prompt verde, texto que se escribe y cursor que parpadea. */
  .hero__escribe {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--e-2);
    margin-top: var(--e-4);
    min-height: 1.6em;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--tinta);
  }

  .hero__prompt {
    color: var(--resalte);
  }

  .hero__cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    translate: 0 0.18em;
    background: var(--accion);
    box-shadow: 0 0 12px var(--accion);
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .hero__disponible {
    margin-top: var(--e-3);
    color: var(--tinta-suave);
    max-width: 40ch;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
  }

  .hero__secundario {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-3);
    margin-top: var(--e-3);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }

  .hero__secundario a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--tinta);
  }

  .hero__secundario a:hover {
    color: var(--accion);
  }

  /* Marcador de estadio: números grandes en tabla, la etiqueta debajo. */
  .marcador {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    justify-content: start;
    margin-top: var(--e-7);
    border-radius: var(--radio-tarjeta);
    border: 1px solid var(--borde-fuerte);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--azul) 22%, transparent), transparent 70%), #071029;
    color: var(--hielo);
    overflow: hidden;
    box-shadow: var(--brillo);
  }

  /* El número va arriba (order) aunque en el HTML la etiqueta va primero, como pide <dl>. */
  .marcador__dato {
    display: grid;
    align-content: start;
    gap: var(--e-1);
    padding: var(--e-4) var(--e-5);
    animation: entrar var(--dur-larga) var(--curva) backwards;
    animation-delay: calc(var(--i) * 120ms + 600ms);
  }

  .marcador__dato + .marcador__dato {
    border-left: 1px solid color-mix(in srgb, var(--hielo) 18%, transparent);
  }

  .marcador dd {
    order: -1;
    margin: 0;
    font-size: 2rem;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--verde-vivo);
    text-shadow: 0 0 18px color-mix(in srgb, var(--verde-vivo) 60%, transparent);
  }

  .marcador dt {
    max-width: 14ch;
    font-size: var(--t-0);
    font-weight: 600;
    line-height: 1.3;
    color: #b9c9ef;
  }

  @media (max-width: 30rem) {
    .marcador__dato {
      padding: var(--e-3) var(--e-4);
    }

    .marcador dd {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 64rem) {
    .hero__rejilla {
      grid-template-columns: 1fr;
      gap: var(--e-7);
    }
  }
</style>

<script>
  // El nombre se ensancha o se estrecha según dónde esté el puntero: usa el eje de ancho de la fuente.
  const nombre = document.querySelector<HTMLElement>('[data-nombre-elastico]');
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fino = window.matchMedia('(pointer: fine)');

  if (nombre && fino.matches && !reducir.matches) {
    let pendiente = 0;
    window.addEventListener(
      'pointermove',
      (e) => {
        cancelAnimationFrame(pendiente);
        pendiente = requestAnimationFrame(() => {
          const caja = nombre.getBoundingClientRect();
          const x = Math.min(Math.max((e.clientX - caja.left) / caja.width, 0), 1);
          // Entre 100 % y 125 % de ancho: siempre legible.
          nombre.style.setProperty('--ancho', String(Math.round(100 + x * 25)));
        });
      },
      { passive: true },
    );
  }

  // Línea de terminal: borra y escribe, una por una, las cosas que construyo.
  const escribe = document.querySelector<HTMLElement>('[data-escribe]');
  const escrito = escribe?.querySelector<HTMLElement>('[data-escrito]');
  if (escribe && escrito && !reducir.matches) {
    const frases = JSON.parse(escribe.dataset.escribe ?? '[]') as string[];
    let indice = 0;
    const esperar = (ms: number) => new Promise((r) => window.setTimeout(r, ms));

    const ciclo = async () => {
      for (;;) {
        await esperar(2200);
        const actual = frases[indice] ?? '';
        for (let n = actual.length; n >= 0; n--) {
          escrito.textContent = actual.slice(0, n);
          await esperar(28);
        }
        indice = (indice + 1) % frases.length;
        const siguiente = frases[indice] ?? '';
        for (let n = 1; n <= siguiente.length; n++) {
          escrito.textContent = siguiente.slice(0, n);
          await esperar(55 + Math.random() * 45);
        }
      }
    };
    void ciclo();
  }

  // Marcador: los números pequeños cuentan desde cero al cargar, como un tablero que se enciende.
  if (!reducir.matches) {
    document.querySelectorAll<HTMLElement>('[data-cuenta]').forEach((dd, i) => {
      const final = Number(dd.dataset.cuenta);
      if (!Number.isFinite(final) || final <= 0 || final > 99) return;
      const inicio = performance.now() + 700 + i * 120;
      const duracion = 900;
      const paso = (ahora: number) => {
        const t = Math.min(Math.max((ahora - inicio) / duracion, 0), 1);
        dd.textContent = String(Math.round(final * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    });
  }
</script>
