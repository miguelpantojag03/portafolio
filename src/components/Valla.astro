---
/**
 * Valla LED de estadio: las tecnologías pasan como publicidad junto a la cancha.
 * Es decorativa (la lista completa y con evidencia está en «Cómo trabajo»), así que va oculta a lectores.
 */
import { tecnologias } from '@/data/perfil';

const nombres = [...tecnologias.enProyectos, ...tecnologias.fueraDeProyectos].map((t) => t.nombre);
---

<div class="valla" aria-hidden="true">
  {[0, 1].map(() => (
    <ul class="valla__cinta">
      {nombres.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  ))}
</div>

<style>
  .valla {
    --alto: 3.5rem;
    position: relative;
    display: flex;
    overflow: hidden;
    height: var(--alto);
    background: var(--azul-noche);
    border-block: 3px solid var(--azul);
    color: var(--verde-vivo);
    /* Se desvanece en los bordes, como una pantalla vista de lado. */
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  /* Rejilla de puntos: el texto parece hecho de LEDs. */
  .valla::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, transparent 0.9px, var(--azul-noche) 1.4px) 0 0 / 4px 4px;
    opacity: 0.55;
    pointer-events: none;
  }

  .valla__cinta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--e-7);
    padding: 0 var(--e-7) 0 0;
    margin: 0;
    list-style: none;
    animation: correr 60s linear infinite;
  }

  .valla:hover .valla__cinta {
    animation-play-state: paused;
  }

  .valla__cinta li {
    display: flex;
    align-items: center;
    gap: var(--e-7);
    white-space: nowrap;
    font-size: 1.375rem;
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-shadow: 0 0 12px color-mix(in srgb, var(--verde-vivo) 70%, transparent);
  }

  /* Entre una marca y otra, un balón azul claro. */
  .valla__cinta li::after {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--azul-claro);
    box-shadow: 0 0 10px var(--azul-claro);
  }

  .valla__cinta li:nth-child(3n + 2) {
    color: var(--hielo);
    text-shadow: 0 0 12px color-mix(in srgb, var(--hielo) 60%, transparent);
  }

  @keyframes correr {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .valla__cinta {
      animation: none;
    }
  }
</style>
