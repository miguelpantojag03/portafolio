---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { obtenerProyectos, type Proyecto } from '@/lib/proyectos';

export const getStaticPaths = (async () => {
  const proyectos = await obtenerProyectos();
  return proyectos.map((p, i) => ({
    params: { slug: p.id },
    props: {
      proyecto: p,
      anterior: proyectos[(i - 1 + proyectos.length) % proyectos.length]!,
      siguiente: proyectos[(i + 1) % proyectos.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  proyecto: Proyecto;
  anterior: Proyecto;
  siguiente: Proyecto;
}

const { proyecto, anterior, siguiente } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="caso">
    <header class="caso__banda">
      <div class="contenedor">
        <p class="caso__volver">
          <a href="/#proyectos">Todos los proyectos</a>
        </p>
        <p class="caso__area">
          <span class="caso__punto" aria-hidden="true"></span>
          {d.area}
        </p>
        <h1 class="caso__titulo">{d.titulo}</h1>
        <p class="caso__resumen">{d.resumen}</p>
      </div>
    </header>

    <div class="contenedor">
      <dl class="ficha revelar">
        <div>
          <dt>Mi papel</dt>
          <dd>{d.rol}</dd>
        </div>
        <div>
          <dt>Contexto</dt>
          <dd>{d.contexto}</dd>
        </div>
        <div>
          <dt>Fecha</dt>
          <dd>
            <time datetime={d.fechaIso}>{d.fecha}</time>
          </dd>
        </div>
        <div>
          <dt>Tecnologías</dt>
          <dd>{d.stack.join(', ')}</dd>
        </div>
      </dl>

      {d.portada && (
        <figure class="caso__portada">
          <Image
            src={d.portada.src}
            alt={d.portada.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 85rem) 75rem, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="prosa">
        <Content />

        {d.enlaces.length > 0 && (
          <section aria-labelledby="enlaces">
            <h2 id="enlaces">Enlaces</h2>
            <ul class="enlaces" role="list">
              {d.enlaces.map((e) => (
                <li>
                  <a class="boton" href={e.url} target="_blank" rel="noopener">
                    {e.texto}
                    <span class="solo-lectores"> (se abre en otra pestaña)</span>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14">
                      <path d="M5 2h7v7M12 2 4 10" fill="none" stroke="currentColor" stroke-width="2" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {d.galeria.length > 0 && (
        <section class="galeria" aria-labelledby="galeria-titulo">
          <h2 id="galeria-titulo" class="solo-lectores">
            Capturas
          </h2>
          {d.galeria.map((g) => (
            <figure class="revelar">
              <Image
                src={g.src}
                alt={g.alt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 64rem) 30vw, 92vw"
                loading="lazy"
              />
              {g.pie && <figcaption class="texto-suave">{g.pie}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      <nav class="vecinos" aria-label="Otros proyectos">
        <a href={`/proyectos/${anterior.id}`} rel="prev">
          <span class="vecinos__dir texto-suave">← Proyecto anterior</span>
          <span class="vecinos__nombre">{anterior.data.titulo}</span>
        </a>
        <a href={`/proyectos/${siguiente.id}`} rel="next" class="vecinos__siguiente">
          <span class="vecinos__dir texto-suave">Proyecto siguiente →</span>
          <span class="vecinos__nombre">{siguiente.data.titulo}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  /* Portada del caso: oscura, con dos luces de estadio y una rejilla que se apaga hacia abajo. */
  .caso__banda {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--e-9) var(--e-8);
    border-bottom: 1px solid var(--borde);
  }

  .caso__banda::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 80% at 85% 10%, color-mix(in srgb, var(--azul) 45%, transparent), transparent 70%),
      radial-gradient(
        40% 70% at 10% 100%,
        color-mix(in srgb, var(--verde-vivo) 18%, transparent),
        transparent 70%
      ),
      linear-gradient(var(--borde) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--borde) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(#000 55%, transparent);
  }

  .caso__volver {
    margin-bottom: var(--e-6);
  }

  .caso__volver a {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 2.75rem;
    padding-inline: var(--e-4);
    border: 1px solid var(--borde-fuerte);
    border-radius: var(--radio-boton);
    background: var(--vidrio);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--dur-corta) var(--curva);
  }

  .caso__volver a::before {
    content: '←' / '';
    transition: translate var(--dur-media) var(--curva-rebote);
  }

  .caso__volver a:hover {
    border-color: var(--accion);
  }

  .caso__volver a:hover::before {
    translate: -3px 0;
  }

  .caso__area {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--resalte);
  }

  .caso__punto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--resalte);
    box-shadow: 0 0 12px var(--resalte);
  }

  .caso__titulo {
    font-size: clamp(2.75rem, 8vw, 7rem);
    font-stretch: 125%;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    background: linear-gradient(
      180deg,
      var(--tinta) 35%,
      color-mix(in srgb, var(--tinta) 50%, var(--accion))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: subir var(--dur-larga) var(--curva) backwards;
  }

  .caso__resumen {
    margin-top: var(--e-5);
    font-size: var(--t-2);
    font-weight: 500;
    line-height: 1.4;
    max-width: 44ch;
    color: var(--tinta-suave);
    animation: subir var(--dur-larga) var(--curva) 120ms backwards;
  }

  @keyframes subir {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  @media (forced-colors: active) {
    .caso__titulo {
      color: CanvasText;
      background: none;
    }
  }

  /* Ficha: cuatro tarjetas de vidrio que se montan sobre el borde de la portada. */
  .ficha {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--e-3);
    margin-top: calc(-1 * var(--e-6));
  }

  .ficha > div {
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--borde);
    border-radius: 16px;
    background: var(--vidrio);
    backdrop-filter: blur(14px);
    box-shadow: var(--sombra);
  }

  .ficha dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--resalte);
    margin-bottom: var(--e-2);
  }

  .ficha dd {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
  }

  /* La captura flota sobre un escenario con brillo azul. */
  .caso__portada {
    position: relative;
    display: grid;
    place-items: center;
    margin-top: var(--e-7);
    padding: var(--e-7) var(--e-6);
    overflow: hidden;
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
    background:
      radial-gradient(60% 70% at 50% 40%, color-mix(in srgb, var(--azul) 35%, transparent), transparent 70%),
      #040916;
  }

  .caso__portada img {
    width: auto;
    max-width: 100%;
    max-height: 34rem;
    object-fit: contain;
    border-radius: var(--radio-imagen);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
  }

  .prosa {
    max-width: var(--medida);
    padding-block: var(--e-7);
  }

  .prosa :global(h2) {
    position: relative;
    padding-top: var(--e-4);
    font-size: var(--t-3);
    font-stretch: 110%;
    font-weight: 750;
    line-height: 1.1;
    margin-top: var(--e-8);
    margin-bottom: var(--e-4);
  }

  /* Cada título del caso lleva encima una rayita con el degradado. */
  .prosa :global(h2)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 3px;
    border-radius: 3px;
    background: var(--degradado);
  }

  .prosa > :global(h2:first-child) {
    margin-top: 0;
  }

  .prosa :global(h3) {
    font-size: var(--t-2);
    font-weight: 700;
    line-height: 1.25;
    margin-top: var(--e-6);
    margin-bottom: var(--e-3);
  }

  .prosa :global(p),
  .prosa :global(ul) {
    margin-bottom: var(--e-4);
  }

  .prosa :global(ul) {
    padding-left: 1.2em;
  }

  .prosa :global(li + li) {
    margin-top: var(--e-2);
  }

  /* Arquitectura: la lista ordenada que sigue al título se dibuja como diagrama de cajas conectadas. */
  .prosa :global(h2#arquitectura + ol) {
    display: grid;
    gap: var(--e-5);
    max-width: 40rem;
    padding: 0;
    list-style: none;
    counter-reset: capa;
  }

  .prosa :global(h2#arquitectura + ol > li) {
    position: relative;
    margin: 0;
    padding: var(--e-4) var(--e-5) var(--e-4) 4.25rem;
    border: 1px solid var(--borde-fuerte);
    border-radius: 16px;
    background: var(--vidrio);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
    counter-increment: capa;
  }

  /* El número de la capa, en un círculo con el degradado. */
  .prosa :global(h2#arquitectura + ol > li)::before {
    content: '0' counter(capa);
    content: '0' counter(capa) / '';
    position: absolute;
    left: var(--e-4);
    top: var(--e-4);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--degradado);
    color: var(--sobre-accion);
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .prosa :global(h2#arquitectura + ol > li strong) {
    display: block;
    color: var(--tinta);
    font-size: var(--t-1);
    font-stretch: 110%;
    font-weight: 750;
  }

  .prosa :global(h2#arquitectura + ol > li:not(:last-child)::after) {
    content: '';
    position: absolute;
    left: calc(var(--e-4) + 1.125rem - 1px);
    top: 100%;
    width: 2px;
    height: calc(var(--e-5) + 2px);
    background: var(--degradado);
  }

  .prosa :global(strong) {
    font-weight: 700;
  }

  .prosa :global(code) {
    padding: 0.05em 0.3em;
    border: 1px solid var(--borde-fuerte);
    border-radius: 6px;
    background: var(--vidrio);
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    list-style: none;
    padding: 0;
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-6);
    padding-bottom: var(--e-8);
  }

  .galeria img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: var(--e-3);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
    background:
      radial-gradient(70% 70% at 50% 40%, color-mix(in srgb, var(--azul) 25%, transparent), transparent 70%),
      #040916;
    transition:
      border-color var(--dur-media) var(--curva),
      translate var(--dur-media) var(--curva);
  }

  .galeria figure:hover img {
    border-color: color-mix(in srgb, var(--accion) 55%, transparent);
    translate: 0 -4px;
  }

  .galeria figcaption {
    margin-top: var(--e-2);
    font-size: 0.9375rem;
  }

  .vecinos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5);
    padding-block: var(--e-7) var(--e-9);
  }

  .vecinos a {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-5);
    border: 1px solid var(--borde);
    border-radius: var(--radio-tarjeta);
    background: var(--vidrio);
    text-decoration: none;
    transition:
      border-color var(--dur-media) var(--curva),
      box-shadow var(--dur-media) var(--curva);
  }

  .vecinos a:hover {
    border-color: color-mix(in srgb, var(--accion) 60%, transparent);
    box-shadow: var(--brillo);
  }

  .vecinos__siguiente {
    text-align: right;
  }

  .vecinos__nombre {
    font-size: var(--t-3);
    font-stretch: 115%;
    font-weight: 800;
    line-height: 1.05;
  }

  .vecinos a:hover .vecinos__nombre {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 40rem) {
    .vecinos {
      grid-template-columns: 1fr;
    }

    .vecinos__siguiente {
      text-align: left;
    }
  }
</style>
