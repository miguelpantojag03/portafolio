---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { obtenerProyectos, type Proyecto } from '@/lib/proyectos';

export const getStaticPaths = (async () => {
  const proyectos = await obtenerProyectos();
  return proyectos.map((p, i) => ({
    params: { slug: p.id },
    props: {
      proyecto: p,
      anterior: proyectos[(i - 1 + proyectos.length) % proyectos.length]!,
      siguiente: proyectos[(i + 1) % proyectos.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  proyecto: Proyecto;
  anterior: Proyecto;
  siguiente: Proyecto;
}

const { proyecto, anterior, siguiente } = Astro.props;
const d = proyecto.data;
const { Content } = await render(proyecto);
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="caso">
    <header class="caso__banda">
      <div class="contenedor">
        <p class="caso__volver">
          <a href="/#proyectos">Todos los proyectos</a>
        </p>
        <h1 class="caso__titulo">{d.titulo}</h1>
        <p class="caso__resumen">{d.resumen}</p>
      </div>
    </header>

    <div class="contenedor">
      <dl class="ficha">
        <div>
          <dt>Mi papel</dt>
          <dd>{d.rol}</dd>
        </div>
        <div>
          <dt>Contexto</dt>
          <dd>{d.contexto}</dd>
        </div>
        <div>
          <dt>Fecha</dt>
          <dd>
            <time datetime={d.fechaIso}>{d.fecha}</time>
          </dd>
        </div>
        <div>
          <dt>Tecnologías</dt>
          <dd>{d.stack.join(', ')}</dd>
        </div>
      </dl>

      {d.portada && (
        <figure class="caso__portada">
          <Image
            src={d.portada.src}
            alt={d.portada.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 85rem) 75rem, 92vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="prosa">
        <Content />

        {d.enlaces.length > 0 && (
          <section aria-labelledby="enlaces">
            <h2 id="enlaces">Enlaces</h2>
            <ul class="enlaces" role="list">
              {d.enlaces.map((e) => (
                <li>
                  <a class="boton" href={e.url} target="_blank" rel="noopener">
                    {e.texto}
                    <span class="solo-lectores"> (se abre en otra pestaña)</span>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14">
                      <path d="M5 2h7v7M12 2 4 10" fill="none" stroke="currentColor" stroke-width="2" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {d.galeria.length > 0 && (
        <section class="galeria" aria-labelledby="galeria-titulo">
          <h2 id="galeria-titulo" class="solo-lectores">
            Capturas
          </h2>
          {d.galeria.map((g) => (
            <figure>
              <Image
                src={g.src}
                alt={g.alt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 64rem) 30vw, 92vw"
                loading="lazy"
              />
              {g.pie && <figcaption class="texto-suave">{g.pie}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      <nav class="vecinos" aria-label="Otros proyectos">
        <a href={`/proyectos/${anterior.id}`} rel="prev">
          <span class="vecinos__dir texto-suave">Proyecto anterior</span>
          <span class="vecinos__nombre">{anterior.data.titulo}</span>
        </a>
        <a href={`/proyectos/${siguiente.id}`} rel="next" class="vecinos__siguiente">
          <span class="vecinos__dir texto-suave">Proyecto siguiente →</span>
          <span class="vecinos__nombre">{siguiente.data.titulo}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>

<style>
  /* Banda azul en ambos temas, con una franja verde abajo: la camiseta del proyecto. */
  .caso__banda {
    background: var(--azul);
    color: var(--hielo);
    border-bottom: 10px solid var(--cancha);
    padding-block: var(--e-8) var(--e-7);
  }

  .caso__volver {
    margin-bottom: var(--e-6);
  }

  .caso__volver a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .caso__banda :focus-visible {
    outline-color: var(--verde-vivo);
  }

  .caso__titulo {
    font-size: var(--t-5);
    font-stretch: 125%;
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .caso__resumen {
    margin-top: var(--e-5);
    font-size: var(--t-2);
    font-weight: 500;
    line-height: 1.35;
    max-width: 44ch;
  }

  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--e-5) var(--e-6);
    padding-block: var(--e-7);
    border-bottom: var(--trazo) solid var(--tinta);
  }

  .ficha dt {
    font-size: var(--t-0);
    font-weight: 650;
    color: var(--tinta-suave);
    margin-bottom: var(--e-1);
  }

  .ficha dd {
    margin: 0;
    font-weight: 550;
  }

  .caso__portada {
    margin-top: var(--e-7);
  }

  /* Fondo negro de marco; la imagen nunca se agranda más que su tamaño real. */
  .caso__portada {
    display: grid;
    place-items: center;
    padding: var(--e-6);
    background: var(--marino);
    border-radius: var(--radio-imagen);
  }

  .caso__portada img {
    width: auto;
    max-width: 100%;
    max-height: 36rem;
    object-fit: contain;
  }

  .prosa {
    max-width: var(--medida);
    padding-block: var(--e-7);
  }

  .prosa :global(h2) {
    font-size: var(--t-3);
    font-stretch: 110%;
    font-weight: 750;
    line-height: 1.1;
    margin-top: var(--e-8);
    margin-bottom: var(--e-4);
  }

  .prosa > :global(h2:first-child) {
    margin-top: 0;
  }

  .prosa :global(h3) {
    font-size: var(--t-2);
    font-weight: 700;
    line-height: 1.25;
    margin-top: var(--e-6);
    margin-bottom: var(--e-3);
  }

  .prosa :global(p),
  .prosa :global(ul) {
    margin-bottom: var(--e-4);
  }

  .prosa :global(ul) {
    padding-left: 1.2em;
  }

  .prosa :global(li + li) {
    margin-top: var(--e-2);
  }

  /* Arquitectura: la lista ordenada que sigue al título se dibuja como diagrama de cajas conectadas. */
  .prosa :global(h2#arquitectura + ol) {
    display: grid;
    gap: var(--e-6);
    max-width: 40rem;
    padding: 0;
    list-style: none;
  }

  .prosa :global(h2#arquitectura + ol > li) {
    position: relative;
    margin: 0;
    padding: var(--e-4) var(--e-5);
    border: var(--trazo) solid var(--tinta);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }

  .prosa :global(h2#arquitectura + ol > li strong) {
    display: block;
    color: var(--tinta);
    font-size: var(--t-1);
    font-stretch: 110%;
    font-weight: 750;
  }

  .prosa :global(h2#arquitectura + ol > li:not(:last-child)::after) {
    content: '';
    position: absolute;
    left: var(--e-6);
    top: 100%;
    width: var(--trazo);
    height: calc(var(--e-6) + var(--trazo));
    background: var(--tinta);
  }

  .prosa :global(strong) {
    font-weight: 700;
  }

  .prosa :global(code) {
    padding: 0.05em 0.3em;
    border: 1px solid var(--tinta-suave);
    border-radius: 3px;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    list-style: none;
    padding: 0;
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-6);
    padding-bottom: var(--e-8);
  }

  .galeria img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--marino);
    border-radius: var(--radio-imagen);
  }

  .galeria figcaption {
    margin-top: var(--e-2);
    font-size: 0.9375rem;
  }

  .vecinos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5);
    padding-block: var(--e-7) var(--e-9);
    border-top: var(--trazo) solid var(--tinta);
  }

  .vecinos a {
    display: grid;
    gap: var(--e-1);
    text-decoration: none;
    padding-block: var(--e-2);
  }

  .vecinos__siguiente {
    text-align: right;
  }

  .vecinos__nombre {
    font-size: var(--t-3);
    font-stretch: 115%;
    font-weight: 800;
    line-height: 1.05;
  }

  .vecinos a:hover .vecinos__nombre {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 40rem) {
    .vecinos {
      grid-template-columns: 1fr;
    }

    .vecinos__siguiente {
      text-align: left;
    }
  }
</style>
